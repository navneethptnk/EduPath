# EduPath API Configuration
NODE_ENV=development
PORT=3000

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# Admin API key for manual refresh endpoint
ADMIN_API_KEY=edupath-admin-2024-secure-key

# Database configuration
DB_PATH=./edupath_announcements.db

# Logging configuration
LOG_LEVEL=info
LOG_FILE=./logs/edupath-api.log

# Data aggregation settings
UPDATE_FREQUENCY_HOURS=6
CACHE_DURATION_MINUTES=30

# External API configurations (if needed in future)
# NTA_API_KEY=your_nta_api_key_here
# UPSC_API_KEY=your_upsc_api_key_here
# NSP_API_KEY=your_nsp_api_key_here

# Security settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Features flags
ENABLE_CRON_JOBS=true
ENABLE_DETAILED_LOGGING=true
ENABLE_CACHE=true