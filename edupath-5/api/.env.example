# EduPath Unified API Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=3000

# API Security
ADMIN_API_KEY=edupath-admin-2024-secure-key
JWT_SECRET=your-jwt-secret-key-here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://edupath.yourdomain.com

# Database Configuration
DB_PATH=./data/edupath_announcements.db
DB_BACKUP_PATH=./backups/

# Data Source Configuration
ENABLE_AUTO_REFRESH=true
REFRESH_INTERVAL_HOURS=6
MAX_RETRIES=3
REQUEST_TIMEOUT=30000

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/api.log

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration
CACHE_TTL=3600
ENABLE_CACHE=true

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# External APIs (when available)
NTA_API_KEY=your-nta-api-key
UPSC_API_KEY=your-upsc-api-key
NSP_API_KEY=your-nsp-api-key

# Email Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
NOTIFICATION_EMAIL=admin@edupath.com

# Webhook Configuration (optional)
WEBHOOK_URL=https://your-webhook-endpoint.com/notify
WEBHOOK_SECRET=your-webhook-secret